+		# The console's CPU is a Pentium III Coppermine: MMX and SSE, no SSE2.
+		# scripts/waifulib/compiler_optimizations.py appends '-march=pentium-m
+		# -mtune=core2' for every 32-bit x86 target, "because HLSDK compiles
+		# with these options under Linux" -- and a Pentium M *does* have SSE2,
+		# so clang emitted instructions the Xbox cannot execute. Measured on
+		# the first build: 118 of 176 objects, 2892 instructions.
+		#
+		# This is the same bug that killed the engine's first boot on hardware
+		# (BUILD.md section 21.2), in a second project. It has to go in
+		# CPPFLAGS, not CFLAGS: the compile command emits CPPFLAGS *after*
+		# CFLAGS, and the -march above is added later in configure(). Last
+		# flag on the command line wins.
+		conf.env.append_unique('CPPFLAGS', ['-march=pentium3', '-mno-sse2'])
