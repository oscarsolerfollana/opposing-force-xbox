-	conf.check_pic(True) # modern defaults
+	if conf.env.DEST_OS == 'nxdk':
+		# external/nxdk holds the compat layer for the gaps between pdclib and
+		# what hlsdk assumes: <sys/types.h>, <memory.h>, va_list, the
+		# DLL_PROCESS_* constants and the cursor API. The header is force-included
+		# so that no hlsdk source has to be touched.
+		nxdk_compat = conf.path.find_dir('external/nxdk').abspath()
