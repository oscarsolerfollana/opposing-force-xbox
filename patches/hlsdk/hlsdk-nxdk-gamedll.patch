+class Nxdk:
+	'''Original Xbox, via the nxdk toolchain (https://github.com/XboxDev/nxdk).
+
+	Modelled on the PSVita and NintendoSwitch classes above: a console SDK
+	rooted at one environment variable, exposing cc/cxx/ar/strip and the flag
+	sets the target needs.
+
+	Two things make this one different from the other consoles:
+
+	  * nxdk is not a GCC cross-toolchain but clang targeting
+	    i386-pc-windows-msvc, with lld-link as linker. So the C++ ABI is the
+	    MSVC one -- the same ABI the original GoldSrc gamedlls use.
+	  * The libc is pdclib plus a small Win32 shim, both freestanding. Hence
+	    -ffreestanding -nostdlib and the pile of -I in nxdk-cc; we reuse the
+	    nxdk-cc/nxdk-cxx wrappers rather than duplicating that list here.
+	'''
+	ctx      = None # waf context
+	arch     = 'x86'
+	nxdk_dir = None
+
+	def __init__(self, ctx):
+		self.ctx = ctx
+
+		for i in NXDK_ENVVARS:
+			self.nxdk_dir = os.getenv(i)
+			if self.nxdk_dir != None:
+				break
+		else:
+			ctx.fatal('Set %s environment variable pointing to the nxdk directory!' %
+				' or '.join(NXDK_ENVVARS))
+
+		self.nxdk_dir = os.path.abspath(self.nxdk_dir)
+
+		for i in ['bin/nxdk-cc', 'bin/nxdk-cxx', 'lib/libpdclib.lib']:
+			if not os.path.exists(os.path.join(self.nxdk_dir, i)):
+				ctx.fatal('`%s` not found in `%s`. Build nxdk first (make -C samples/hello)!' %
+					(i, self.nxdk_dir))
+
+	def gen_toolchain_path(self):
+		return os.path.join(self.nxdk_dir, 'bin', 'nxdk-')
+
+	def cc(self):
+		return self.gen_toolchain_path() + 'cc'
+
+	def cxx(self):
+		return self.gen_toolchain_path() + 'cxx'
+
+	def ar(self):
+		return self.gen_toolchain_path() + 'lib'
+
+	def strip(self):
+		return 'true' # lld-link strips already; there is no nxdk-strip
+
+	def cflags(self, cxx = False):
+		cflags = []
+		# the wrappers already set -target/-march/-ffreestanding/-nostdlib and
+		# every -I of pdclib, libcxx, winapi and the vcruntime shims
+		cflags += ['-DNXDK', '-D_XBOX']
+		# pdclib is C99/C11-strict and has no <sys/*>; hlsdk expects a few
+		# things that only live in the nxdk compat headers
+		cflags += ['-I%s' % os.path.join(self.nxdk_dir, 'lib', 'xboxrt', 'libc_extensions')]
+		# no cursor, no window manager, no DLL loader: see the compat header
+		cflags += ['-Wno-deprecated-declarations']
+		return cflags
+
+	def linkflags(self):
+		# A gamedll is a real PE DLL: relocatable, no entry point (DllMain is
+		# never called, because nxdk has no loader), i386.
+		#
+		# /fixed:no and /base undo two defaults that bin/nxdk-link hardcodes for
+		# XBE executables: -fixed would drop the .reloc section, and
+		# -base:0x00010000 would put the DLL on top of the engine's own image.
+		return ['-Wl,/dll', '-Wl,/noentry', '-Wl,/machine:x86',
+			'-Wl,/nodefaultlib', '-Wl,/fixed:no', '-Wl,/base:0x10000000']
+
+	def ldflags(self):
+		l = os.path.join(self.nxdk_dir, 'lib')
+		return [os.path.join(l, i) for i in
+			['libpdclib.lib', 'libxboxrt.lib', 'libwinapi.lib',
+			 'libnxdk.lib', 'libnxdk_hal.lib',
+			 os.path.join('xboxkrnl', 'libxboxkrnl.lib')]]
+
 def options(opt):
 	xc = opt.add_option_group('Cross compile options')
 	xc.add_option('--android', action='store', dest='ANDROID_OPTS', default=None,
@@ -537,6 +621,8 @@ def options(opt):
 		help='enable building for Nintendo Switch [default: %(default)s]')
 	xc.add_option('--psvita', action='store_true', dest='PSVITA', default = False,
 		help='enable building for PlayStation Vita [default: %(default)s]')
+	xc.add_option('--nxdk', action='store_true', dest='NXDK', default = False,
+		help='enable building for original Xbox via nxdk [default: %(default)s]')
 	xc.add_option('--sailfish', action='store', dest='SAILFISH', default = None,
 		help='enable building for Sailfish/Aurora')
 	xc.add_option('--emscripten', action='store_true', dest='EMSCRIPTEN', default = None,
@@ -636,6 +722,21 @@ def configure(conf):
 		conf.env.LIB_M = ['m']
 		conf.env.VRTLD = ['vrtld']
 		conf.env.DEST_OS = 'psvita'
+	elif conf.options.NXDK:
+		conf.nxdk = nxdk = Nxdk(conf)
+		conf.environ['CC'] = nxdk.cc()
+		conf.environ['CXX'] = nxdk.cxx()
+		conf.environ['AR'] = nxdk.ar()
+		conf.environ['STRIP'] = nxdk.strip()
+		conf.env.CFLAGS += nxdk.cflags()
+		conf.env.CXXFLAGS += nxdk.cflags(True)
+		conf.env.LINKFLAGS += nxdk.linkflags()
+		conf.env.LDFLAGS += nxdk.ldflags()
+		# pdclib provides the math functions hlsdk needs; there is no separate libm
+		conf.env.HAVE_M = True
+		conf.env.LIB_M = []
+		conf.env.DEST_OS = 'nxdk'
+		conf.env.DEST_CPU = 'x86'
 	elif conf.options.EMSCRIPTEN:
 		# Emscripten compiler is just wrapper to clang
 		# But we need to setup platform modifiers, they all are contained inside c_emscripten.py for now
@@ -650,7 +751,10 @@ def configure(conf):
 	conf.env.MAGX = conf.options.MAGX
 	conf.env.MSVC_WINE = conf.options.MSVC_WINE
 	conf.env.SAILFISH = conf.options.SAILFISH
-	MACRO_TO_DESTOS = OrderedDict({ '__ANDROID__' : 'android', '__SWITCH__' : 'nswitch', '__vita__' : 'psvita', '__wasi__': 'wasi', '__EMSCRIPTEN__' : 'emscripten' })
+	# NXDK must come before the stock table: nxdk-cc targets i386-pc-windows-msvc,
+	# so _WIN32 is defined and waf would otherwise call this a plain win32 build
+	# and go looking for user32/winmm.
+	MACRO_TO_DESTOS = OrderedDict({ '__ANDROID__' : 'android', '__SWITCH__' : 'nswitch', '__vita__' : 'psvita', 'NXDK' : 'nxdk', '__wasi__': 'wasi', '__EMSCRIPTEN__' : 'emscripten' })
 	for k in c_config.MACRO_TO_DESTOS:
