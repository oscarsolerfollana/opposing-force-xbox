diff --git a/external/nxdk/nxdk_compat.h b/external/nxdk/nxdk_compat.h
new file mode 100644
index 00000000..9e1f2931
--- /dev/null
+++ b/external/nxdk/nxdk_compat.h
@@ -0,0 +1,70 @@
+/*
+ * nxdk_hlsdk_compat.h — capa de compatibilidad para compilar hlsdk-portable
+ * (rama opfor) con el toolchain nxdk (clang -target i386-pc-windows-msvc).
+ *
+ * Se inyecta con -include; no se toca ningún fuente de hlsdk. Ese es el punto:
+ * el árbol de hlsdk sigue produciendo los builds i386/win32 que ya funcionan.
+ *
+ * Cada bloque documenta QUÉ falta en nxdk y POR QUÉ el reemplazo es válido.
+ * Un port de verdad movería esto a la capa de plataforma de hlsdk; aquí sirve
+ * para medir cuánto código del juego compila sin tocarlo.
+ */
+#ifndef NXDK_HLSDK_COMPAT_H
+#define NXDK_HLSDK_COMPAT_H
+
+#ifdef NXDK
+
+/* ------------------------------------------------------------------ TRIVIAL
+ * va_list. En MSVC llega por <vadefs.h> arrastrado por <windows.h>; el
+ * windows.h reducido de nxdk no lo hace. pdclib sí trae <stdarg.h> completo.
+ * Afecta a dlls/util.cpp y cl_dll/hl/hl_weapons.cpp (ALERT/Con_Printf varargs).
+ */
+#include <stdarg.h>
+
+/* ------------------------------------------------------------------ TRIVIAL
+ * DLL_PROCESS_ATTACH / DLL_PROCESS_DETACH. El winnt.h de nxdk no los declara
+ * porque nxdk no tiene cargador de DLLs (ver §18.5): nada llama nunca a
+ * DllMain. Los valores son los de la ABI de Win32; se definen para que
+ * dlls/h_export.cpp compile tal cual.
+ */
+#ifndef DLL_PROCESS_DETACH
+#define DLL_PROCESS_DETACH 0
+#endif
+#ifndef DLL_PROCESS_ATTACH
+#define DLL_PROCESS_ATTACH 1
+#endif
+#ifndef DLL_THREAD_ATTACH
+#define DLL_THREAD_ATTACH  2
+#endif
+#ifndef DLL_THREAD_DETACH
+#define DLL_THREAD_DETACH  3
+#endif
+
+/* ------------------------------------------------------------------ MEDIANO
+ * POINT. Estructura de <windef.h> ausente en nxdk. cl_dll/in_camera.cpp la usa
+ * solo como par de enteros para recordar la posición del ratón en la cámara en
+ * tercera persona. La definición es la de Win32 (dos LONG).
+ */
+#ifndef _NXDK_HAVE_POINT
+#define _NXDK_HAVE_POINT
+typedef struct _NXDK_POINT { long x, y; } POINT, *PPOINT, *LPPOINT;
+#endif
+
+/* ------------------------------------------------------------------ MEDIANO
+ * SetCursorPos / GetCursorPos. API de cursor de escritorio; en Xbox no existe
+ * puntero que leer ni recentrar. cl_dll/in_camera.cpp las usa para fijar el
+ * ratón al centro de la ventana mientras se arrastra la cámara en tercera
+ * persona. Se neutralizan: Set no hace nada, Get devuelve (0,0) —lo que anula
+ * el delta y deja la cámara quieta en vez de darle basura—. En consola esa
+ * entrada vendrá del stick derecho, que ya es delta puro y no necesita
+ * recentrado. Es un cambio de comportamiento deliberado, no una traducción.
+ */
+#ifndef SetCursorPos
+#define SetCursorPos( x, y ) ( (void)(x), (void)(y), 0 )
+#endif
+#ifndef GetCursorPos
+#define GetCursorPos( p ) ( (p) ? ( (p)->x = 0, (p)->y = 0, 1 ) : 0 )
+#endif
+
+#endif /* NXDK */
+#endif /* NXDK_HLSDK_COMPAT_H */
diff --git a/external/nxdk/nxdk_runtime.cpp b/external/nxdk/nxdk_runtime.cpp
new file mode 100644
index 00000000..091dc997
--- /dev/null
+++ b/external/nxdk/nxdk_runtime.cpp
@@ -0,0 +1,130 @@
+/*
+ * nxdk_hlsdk_rt.cpp — piezas de runtime que nxdk no trae y que el gamedll de
+ * Opposing Force necesita para enlazar. Dos huecos, ambos "medianos" en la
+ * clasificación de §18: función de biblioteca ausente pero reemplazable.
+ *
+ * Se compila con nxdk-cxx y se añade al enlazado.
+ */
+
+#include <stdlib.h>
+#include <ctype.h>
+
+/* =========================================================================
+ * 1) operator new / delete globales.
+ *
+ * nxdk trae el submódulo libcxx pero NO construye ninguna libcxx.lib: en
+ * lib/ solo hay libpdclib, libwinapi, libxboxrt, libnxdk*. Las cabeceras de
+ * C++ están, la biblioteca no. Como hlsdk se compila con -fno-exceptions
+ * (nxdk-cxx lo fuerza) y no usa RTTI ni contenedores de la STL en el camino
+ * caliente, los únicos símbolos de C++ que faltaban al enlazar el gamedll son
+ * estos cuatro operadores.
+ *
+ * Implementación sobre malloc/free, que sí están en pdclib. Sin excepciones,
+ * un new fallido devuelve NULL en vez de lanzar std::bad_alloc — que es
+ * exactamente lo que hace el resto de GoldSrc de todos modos.
+ * ========================================================================= */
+
+void *operator new( unsigned int size )
+{
+	if( size == 0 ) size = 1;
+	return malloc( size );
+}
+
+void *operator new[]( unsigned int size )
+{
+	if( size == 0 ) size = 1;
+	return malloc( size );
+}
+
+void operator delete( void *p )
+{
+	free( p );
+}
+
+void operator delete[]( void *p )
+{
+	free( p );
+}
+
+/* delete dimensionado (C++14). Clang lo emite en algunos sitios; se redirige. */
+void operator delete( void *p, unsigned int )
+{
+	free( p );
+}
+
+void operator delete[]( void *p, unsigned int )
+{
+	free( p );
+}
+
+/* =========================================================================
+ * 2) atof().
+ *
+ * pdclib DECLARA atof() y strtod() en <stdlib.h> pero no las implementa:
+ *     /_* TODO: atof(), strtof(), strtod(), strtold() *_/
+ * El enlazado lo confirma: _atof queda sin resolver, referenciado 100 veces
+ * desde los KeyValue() de las entidades. Es la función con la que el juego
+ * parsea CADA propiedad flotante de CADA entidad del .bsp, así que sin ella
+ * no se carga ni un mapa.
+ *
+ * Parser decimal con signo y exponente opcional, suficiente para los valores
+ * que Hammer/Worldcraft escriben en un .bsp. No cubre hex-float, infinitos,
+ * NaN ni redondeo correctamente redondeado — nada de eso aparece en un mapa
+ * de GoldSrc.
+ *
+ * NOTA: esto es un tapón para el censo, no la solución definitiva. Lo correcto
+ * sería implementar strtod() en pdclib y mandarlo aguas arriba a nxdk.
+ * ========================================================================= */
+
+extern "C" double atof( const char *nptr )
+{
+	const char *s = nptr;
+	int neg = 0;
+	double val = 0.0;
+
+	if( !s ) return 0.0;
+
+	while( isspace( (unsigned char)*s )) s++;
+
+	if( *s == '-' ) { neg = 1; s++; }
+	else if( *s == '+' ) s++;
+
+	/* parte entera */
+	while( *s >= '0' && *s <= '9' )
+		val = val * 10.0 + (double)( *s++ - '0' );
+
+	/* parte fraccionaria */
+	if( *s == '.' )
+	{
+		double scale = 0.1;
+		s++;
+		while( *s >= '0' && *s <= '9' )
+		{
+			val += (double)( *s++ - '0' ) * scale;
+			scale *= 0.1;
+		}
+	}
+
+	/* exponente */
+	if( *s == 'e' || *s == 'E' )
+	{
+		const char *save = s;
+		int eneg = 0, exp = 0, digits = 0;
+		s++;
+		if( *s == '-' ) { eneg = 1; s++; }
+		else if( *s == '+' ) s++;
+		while( *s >= '0' && *s <= '9' ) { exp = exp * 10 + ( *s++ - '0' ); digits++; }
+
+		if( !digits ) s = save;   /* 'e' suelta: no era exponente */
+		else
+		{
+			double p = 1.0;
+			if( exp > 308 ) exp = 308;
+			while( exp-- ) p *= 10.0;
+			if( eneg ) val /= p;
+			else       val *= p;
+		}
+	}
+
+	return neg ? -val : val;
+}
diff --git a/external/nxdk/sys/types.h b/external/nxdk/sys/types.h
new file mode 100644
index 00000000..789bbaea
--- /dev/null
+++ b/external/nxdk/sys/types.h
@@ -0,0 +1,18 @@
+/*
+ * sys/types.h — TRIVIAL.
+ *
+ * pdclib es una libc C99/C11 estricta: no implementa la jerarquía <sys/*> de
+ * POSIX. external/openbsd/strlcpy.c y strlcat.c la incluyen por costumbre BSD,
+ * pero de ella solo necesitan size_t, que es estándar y vive en <stddef.h>.
+ *
+ * Nota: hacen falta porque nxdk NO trae strlcpy/strlcat (verificado: no están
+ * ni en pdclib/include/string.h ni en xboxrt/libc_extensions/string_ext_.h),
+ * así que HAVE_STRLCPY/HAVE_STRLCAT dan falso y waf compila las de OpenBSD.
+ */
+#ifndef NXDK_COMPAT_SYS_TYPES_H
+#define NXDK_COMPAT_SYS_TYPES_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#endif
