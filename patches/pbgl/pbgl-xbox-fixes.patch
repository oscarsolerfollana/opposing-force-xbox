+/* ###########################################################################
+   NOT UPSTREAM pbGL. Opposing Force X, BUILD.md 40.
+
+   This allocator is the prime suspect for the machine-wide freeze, and it
+   was completely blind. Every texture in the game comes through here, into
+   physically contiguous pages below PBGL_MAXRAM (0x03FFAFFF -- 64 MB, no
+   matter that the console has 128), and nothing said how much was in use or
+   how long the search took. Section 40 reconstructed 50 MB of that 64 in
+   use at the freeze, with the gaps between uploads climbing 177 -> 196 ->
+   806 ms as the region filled and fragmented.
+
+   So: a running total, and a line whenever one allocation takes long enough
+   to matter. Silent when things are healthy; when they are not, it names
+   the allocation and says how full the pool was.
+   ######################################################################## */
+extern void Xbox_Trace(const char *fmt, ...);
+
+#define PBGL_ALLOC_SLOW_MS 100u
+
+static GLuint pbgl_mem_live;   // bytes currently handed out
+static GLuint pbgl_mem_peak;
+static GLuint pbgl_mem_allocs;
+
 void *pbgl_mem_alloc(GLuint size) {
+  const DWORD t0 = GetTickCount();
   void *p = MmAllocateContiguousMemoryEx(size, 0, PBGL_MAXRAM, MEM_ALIGNMENT, PAGE_WRITECOMBINE | PAGE_READWRITE);
+  const DWORD dt = GetTickCount() - t0;
+
   if (!p) {
     pbgl_debug_log("mem: failed to alloc %u bytes", size);
+    Xbox_Trace("pbgl mem: FAILED %u KB after %u ms, live %u KB in %u allocs",
+      size / 1024u, (unsigned)dt, pbgl_mem_live / 1024u, pbgl_mem_allocs);
     return NULL;
   }
+
+  pbgl_mem_live += size;
+  pbgl_mem_allocs++;
+  if (pbgl_mem_live > pbgl_mem_peak)
+    pbgl_mem_peak = pbgl_mem_live;
+
+  // the interesting ones: a contiguous-page search that had to work for it
+  if (dt >= PBGL_ALLOC_SLOW_MS) {
+    Xbox_Trace("pbgl mem: slow alloc %u KB took %u ms, live %u KB / peak %u KB in %u allocs",
+      size / 1024u, (unsigned)dt, pbgl_mem_live / 1024u, pbgl_mem_peak / 1024u, pbgl_mem_allocs);
+  }
+
   return p;
 }
 
 void pbgl_mem_free(void *ptr) {
-  if (ptr)
+  if (ptr) {
     MmFreeContiguousMemory(ptr);
+  }
 }
 
