diff --git a/3rdparty/opus/wscript b/3rdparty/opus/wscript
index 28bb5d1..2275d43 100644
--- a/3rdparty/opus/wscript
+++ b/3rdparty/opus/wscript
@@ -71,7 +71,23 @@ def configure(conf):
 			if conf.env.DEST_SIZEOF_VOID_P > 4:
 				conf.define('OPUS_X86_PRESUME_SSE', 1)
 
-		if conf.check(header_name='emmintrin.h', mandatory = False):
+		# XTRACE -- Opposing Force X, BUILD.md section 21. Not upstream.
+		#
+		# The Xbox CPU is a Pentium III Coppermine: MMX and SSE, no SSE2.
+		# Asking whether emmintrin.h exists answers the wrong question --
+		# clang ships it for every x86 target, whatever the CPU -- and the
+		# -msse2 below goes into the *shared* conf.env.CFLAGS, so every
+		# subproject configured after this one inherits it. The engine is
+		# deliberately last in SUBDIRS, so it got the flag too, and the first
+		# double arithmetic it executed was an invalid opcode on the console.
+		# See BUILD.md section 21.2.
+		#
+		# Nothing is lost here: on 32-bit opus dispatches at run time
+		# (OPUS_HAVE_RTCD below), so its SSE2 paths were dead code on this CPU
+		# to begin with.
+		if conf.env.DEST_OS == 'xbox':
+			pass
+		elif conf.check(header_name='emmintrin.h', mandatory = False):
 			if conf.env.COMPILER_CC != 'msvc':
 				conf.env.CFLAGS += ['-msse2']
 			conf.define('OPUS_X86_MAY_HAVE_SSE2', 1)
@@ -122,10 +138,18 @@ def build(bld):
 	elif bld.env.DEST_CPU.startswith('x86'):
 		sources += ['opus/silk/x86/x86_silk_map.c',
 			'opus/celt/x86/pitch_sse.c',
-			'opus/celt/x86/pitch_sse2.c',
-			'opus/celt/x86/vq_sse2.c',
 			'opus/celt/x86/x86_celt_map.c',
 			'opus/celt/x86/x86cpu.c']
+
+		# XTRACE -- Opposing Force X, BUILD.md section 21. Not upstream.
+		# These two are unconditional SSE2 -- they include <emmintrin.h> and
+		# use the intrinsics with no #ifdef around the body -- so dropping
+		# OPUS_X86_MAY_HAVE_SSE2 in configure() is not enough, the files have
+		# to go too. The Pentium III in the console has no SSE2 and the run
+		# time dispatch would never have reached them.
+		if bld.env.DEST_OS != 'xbox':
+			sources += ['opus/celt/x86/pitch_sse2.c',
+				'opus/celt/x86/vq_sse2.c']
 		includes += ['opus/silk/x86', 'opus/celt/x86']
 
 	defines = ['OPUS_BUILD', 'FLOAT_APPROX', 'PACKAGE_VERSION="1.4.0"', 'CUSTOM_MODES', 'ENABLE_HARDENING']
